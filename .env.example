# URL d'écoute du serveur
PORT=3000

# Dossier des sources Markdown (monté depuis Obsidian).
# Par défaut : ./content
# CONTENT_PATH=/content

# URL publique du site (utilisée pour les URLs absolues : feed, OG, webhook)
SITE_URL=http://localhost:3000

# URL du webhook de publication (n8n) — laissé vide = pas d'appel
PUBLICATION_WEBHOOK_URL=

# Jeton d'écriture webmention.io — optionnel.
# La lecture des Webmentions reçues est publique et ne nécessite pas de jeton.
WEBMENTION_IO_TOKEN=
